# API Configuration

# Backend API Base URL (deployed on Render)
VITE_API_BASE_URL=https://nhs-backend-api.onrender.com

# Application Name
VITE_APP_NAME=NHS A&E Forecasting Platform

# ========================================
# Instructions
# ========================================
#
# This application uses the production backend by default.
#
# For Production Deployment:
# - Copy this file to .env
# - The production URL is already configured above
# - Build: npm run build
# - Deploy the dist/ folder
#
# For Local Backend Development:
# - Copy this file to .env
# - Change VITE_API_BASE_URL to http://localhost:5000
# - Start local backend: cd backend && docker compose up
# 3. Start backend: cd backend && python run.py
# 4. Start frontend: npm run dev
#
# For Vercel Production Deployment:
# 1. Deploy backend to Render (see backend/DEPLOYMENT.md)
# 2. Copy your Render backend URL
# 3. Go to Vercel Dashboard → Project → Settings → Environment Variables
# 4. Update VITE_API_BASE_URL with your Render URL
# 5. Redeploy frontend from Vercel dashboard
#
